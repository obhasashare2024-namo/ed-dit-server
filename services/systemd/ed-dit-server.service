[Unit]
Description=MiniMax H3 Native DiT Microservice (C++)
After=network.target

[Service]
Type=simple
User=namobuddha
WorkingDirectory=/mnt/2tbnvS/ed-dit-server
Environment="ED_BACKEND=cuda"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/mnt/2tbnvS/ed-dit-server/build/bin/ed-dit-server --port 9005 --budget-mb 200 --threads 8 --model /mnt/2tbnvS/models/minimax_h3_fl2va_hyperflow_flash_14b-Q3_K_M.gguf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
